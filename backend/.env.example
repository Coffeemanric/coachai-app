# ── Stripe ───────────────────────────────────────────────────────────────────
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Create a recurring product in Stripe dashboard, copy the Price ID here
# Dashboard → Products → Add product → $9.99/month → copy price_xxx ID
STRIPE_PRICE_ID=price_...

# ── App URLs ──────────────────────────────────────────────────────────────────
# Where your subscribe page is hosted (this backend serves it from /public)
FRONTEND_URL=https://api.diamondcoach.app

# ── Email (license key delivery) ─────────────────────────────────────────────
# Option A: Gmail app password  (Settings → Security → App Passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=CoachAI <noreply@diamondcoach.app>

# Option B: Resend (https://resend.com — 3000 free emails/month)
# RESEND_API_KEY=re_...

# ── Security ──────────────────────────────────────────────────────────────────
# Random string — used to sign admin requests if you add a dashboard later
ADMIN_SECRET=change-me-to-something-random

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
