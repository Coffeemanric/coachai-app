# ── Square Payments ───────────────────────────────────────────────────────────
# Get these from https://developer.squareup.com/apps → your app

# Your Square Access Token (sandbox: EAAAl... / production: EAAAl...)
SQUARE_ACCESS_TOKEN=EAAAl...

# sandbox | production
SQUARE_ENVIRONMENT=production

# Your Square Location ID (Developer Dashboard → Locations)
SQUARE_LOCATION_ID=L...

# Subscription Plan Variation ID — created in Square Dashboard:
# Catalog → Subscriptions → New Plan → $9.99/month → copy the Variation ID
SQUARE_PLAN_VARIATION_ID=...

# Webhook Signature Key (Square Developer → Webhooks → your endpoint → Signature key)
SQUARE_WEBHOOK_SIGNATURE_KEY=...

# ── App URLs ──────────────────────────────────────────────────────────────────
# Full URL where this backend is deployed (used for webhook signature verification)
FRONTEND_URL=https://your-app.onrender.com

# ── Email (license key delivery) ─────────────────────────────────────────────
# Option A: Gmail app password  (Google Account → Security → App Passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=CoachAI <you@gmail.com>

# Option B: Resend (https://resend.com — 3,000 free emails/month)
# RESEND_API_KEY=re_...

# ── Security ──────────────────────────────────────────────────────────────────
ADMIN_SECRET=change-me-to-a-random-string-32-chars

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
